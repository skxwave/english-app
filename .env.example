# Copy to .env and fill in. `xcrun devicectl list devices` gives PHONE_ID; xcodebuild's UDID is PHONE_UDID.
PHONE_UDID=
PHONE_ID=
TEAM_ID=
# Your own unique reverse-DNS id (the project file only holds a placeholder).
BUNDLE_ID=
# Optional: simulator used by `just build` / `just run`.
SIMULATOR="iPhone 17 Pro"
